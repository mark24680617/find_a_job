# Files NOT uploaded to Cloud Build by `gcloud run deploy --source .`.
# Syntax is the same as .gitignore (see `gcloud topic gcloudignore`).

.git

# Reinstalled / rebuilt by the buildpack (npm ci + next build).
node_modules
.next
tsconfig.tsbuildinfo

# Not needed to build or run the service.
# `scripts` are dev-only tools, and several import `../tests/fixtures`: uploading them without
# `tests` fails `next build`'s type-check. Leave them in tsconfig so local `tsc` still checks them.
tests
scripts
docs
.superpowers
.impeccable.md
AGENTS.md
CLAUDE.md
.DS_Store
# Local tool state (session memory, language-server cache, agent worktrees, browser-tool logs),
# never part of the service. A worktree under .claude/ is a second copy of src/, which the
# build's type-check would read too.
.remember
.serena
.claude
.playwright-mcp

# Secrets: env vars are set on the service, never baked into the image.
.env*
