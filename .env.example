# Copy to .env.local and fill in real values. .env.local is gitignored — never commit it.

# Gemini Developer API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
NEXT_PUBLIC_FB_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FB_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FB_PROJECT_ID=your-project-id
NEXT_PUBLIC_FB_APP_ID=1:000000000000:web:0000000000000000000000

# Optional — the research reads Reddit write-ups only with an app id, because Reddit refuses
# its public JSON to servers. Create one at https://www.reddit.com/prefs/apps ("create app" →
# installed app); an installed app has no secret, so leave the second line commented out.
# Without an id the research reads no Reddit at all and everything else works unchanged.
# REDDIT_CLIENT_ID=your-reddit-app-id
# REDDIT_CLIENT_SECRET=only-for-a-confidential-app

# Optional — the Resume page's yes/no judge (TypeSafe's Jev). Without it every judgement falls
# back to Gemini, and the page says which judge answered.
# TYPESAFE_API_KEY=your-typesafe-api-key

# The Resume tools' kill switch: `true` turns upload and every resume tool route on; anything
# else, unset included, answers 503. Read on every request, so it flips without a rebuild.
RESUME_TOOLS_ENABLED=true

# Optional — units a day across the whole deployment before every resume tool refuses; 200 when unset.
# RESUME_DEPLOYMENT_CEILING=200

# Server-side admin credentials are NOT env vars: run `gcloud auth application-default login`
# locally; Cloud Run supplies them from the runtime service account.
